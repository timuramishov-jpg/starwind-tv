tools/venv
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
# Results from tools/bench.py: result.json carries the address the run was given and the TV's fingerprint.
bench-results/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log

# Шрифты Apple берутся из архива владельца при сборке, в репозиторий не попадают.
launcher/app/src/main/res/font/sf_*.ttf
launcher/app/src/main/res/drawable-nodpi/top_input.png
launcher/app/src/main/res/drawable-nodpi/top_wifi.png
launcher/app/src/main/res/drawable-nodpi/top_settings.png
launcher/app/src/main/res/drawable-nodpi/top_grid.png
launcher/app/src/main/res/drawable-nodpi/top_clean.png
