#!/bin/bash
# Единый инструмент для телевизора StarWind. Запуск: tv <команда>. Без команды печатает справку.
set -u
TV=192.168.31.237
DIR="$HOME/Documents/Claude"
R="$DIR/cleanyourtv"
SECRETS="$DIR/secrets.json"
PKG=com.gathin.tvhome
export TV_HOST=$TV
PY="$R/tools/venv/bin/python"
T() { "$PY" -I "$R/tools/tv.py" "$@"; }
SHOTS="$DIR/shots"; mkdir -p "$SHOTS"
say() { printf '%s\n' "$*"; }
die() { say "ОШИБКА: $*"; exit 1; }
online() { nc -z -G 3 $TV 5555 2>/dev/null || die "телевизор не отвечает: включи его. Если отладка выключена, включи её в настройках лаунчера."; }
home() { T "am start -a android.intent.action.MAIN -c android.intent.category.HOME -n $PKG/.IosHome" > /dev/null; }

keys() {
  [ -f "$SECRETS" ] || die "нет файла $SECRETS"
  ARGS=$(python3 - "$SECRETS" <<'P'
import json,sys,shlex
d=json.load(open(sys.argv[1])); y=d.get("installed",{})
m={"yt_client_id":y.get("client_id",""),"yt_client_secret":y.get("client_secret",""),"yt_api_key":d.get("api_key",""),"kino_key":d.get("kinopoisk_key","")}
print(" ".join(f"--es {k} {shlex.quote(v)}" for k,v in m.items() if v))
P
)
  OUT=$(T "am broadcast -n $PKG/.IosConfig $ARGS")
  case "$OUT" in *"ok "*) say "Ключи переданы в лаунчер" ;; *) say "$OUT"; die "ключи не приняты" ;; esac
}

fonts() {
  Z=$(ls "$DIR"/SF-NF*.zip 2>/dev/null | head -1)
  [ -n "$Z" ] || { say "Нет архива SF, останутся старые шрифты"; return; }
  python3 - "$Z" "$R/launcher/app/src/main/res/font" <<'P'
import zipfile,sys
z=zipfile.ZipFile(sys.argv[1])
for out,src in {"sf_light":"Light","sf_regular":"Regular","sf_medium":"Medium","sf_semibold":"Semibold"}.items():
    open(f"{sys.argv[2]}/{out}.ttf","wb").write(z.read(f"SF NF 17.0d11e1/TTF/SFNS-{src}.ttf"))
# Заставки: широкие цифры прямоугольного циферблата.
import os
assets=os.path.join(os.path.dirname(os.path.dirname(sys.argv[2])),"assets")
os.makedirs(assets,exist_ok=True)
open(f"{assets}/sf_expanded.ttf","wb").write(z.read("SF NF 17.0d11e1/TTF/SFNSExtraExpanded-Medium.ttf"))
P
  # Скруглённые цифры заставки «Большие цифры»: системный SF Pro Rounded с мака.
  A="$R/launcher/app/src/main/assets"
  if [ -f "$DIR/sfx/SFNSRounded.ttf" ]; then cp "$DIR/sfx/SFNSRounded.ttf" "$A/sf_rounded.ttf"
  elif [ -f /System/Library/Fonts/SFNSRounded.ttf ]; then cp /System/Library/Fonts/SFNSRounded.ttf "$A/sf_rounded.ttf"
  else say "Нет SF Pro Rounded, большие цифры будут обычным SF"; fi
}

icons() {
  cp -n "$R/starwind/fallback/"*.png "$R/launcher/app/src/main/res/drawable-nodpi/"
  command -v swift > /dev/null || { say "Нет swift, значки Apple не обновлены (xcode-select --install)"; return; }
  swift "$R/starwind/icons.swift" "$R/launcher/app/src/main/res/drawable-nodpi" || say "Значки не нарисовались, остались прежние"
}

# Свой ключ подписи в ~/Documents/Claude: создаётся один раз, пароль рядом, оба вне git.
signing() {
  KS="$DIR/starwind.jks"; KP="$DIR/starwind.pass"; KA="$DIR/starwind.alias"
  if [ ! -f "$KS" ]; then
    if [ -f "$HOME/.android/debug.keystore" ]; then
      # Ключ, которым подписан лаунчер на телевизоре: обновление встаёт поверх, настройки и вход в YouTube остаются.
      say "== Сохраняю ключ подписи в $KS (один раз)"
      cp "$HOME/.android/debug.keystore" "$KS"; printf android > "$KP"; printf androiddebugkey > "$KA"
    else
      say "== Создаю свой ключ подписи (один раз)"
      openssl rand -hex 16 > "$KP"; printf starwind > "$KA"
      keytool -genkeypair -keystore "$KS" -storepass "$(cat "$KP")" -keypass "$(cat "$KP")" -alias starwind \
        -keyalg RSA -keysize 2048 -validity 36500 -dname "CN=Starwind launcher" > /dev/null 2>&1 || die "ключ не создался"
    fi
    chmod 600 "$KS" "$KP" "$KA"
  fi
  [ -f "$KA" ] || printf starwind > "$KA"
  export STARWIND_KEYSTORE="$KS" STARWIND_KEY_PASS="$(cat "$KP")" STARWIND_KEY_ALIAS="$(cat "$KA")"
}

# Настройки лаунчера с телевизора в $DIR/backup (лаунчер сам держит их копию в Android/data).
backup() {
  rm -rf "$DIR/backup"; mkdir -p "$DIR/backup"
  for f in $(T "ls /sdcard/Android/data/$PKG/files/backup/ 2>/dev/null" | tr -d '\r' | grep '\.xml$'); do
    T "cat /sdcard/Android/data/$PKG/files/backup/$f" > "$DIR/backup/$f"
  done
  ls "$DIR/backup"/*.xml > /dev/null 2>&1
}

# Вернуть настройки из $DIR/backup: лаунчер заберёт их при следующем запуске.
restore() {
  ls "$DIR/backup"/*.xml > /dev/null 2>&1 || return 1
  T "mkdir -p /sdcard/Android/data/$PKG/files/restore"
  for f in "$DIR/backup"/*.xml; do
    "$PY" -I tools/b64push.py "$f" "/sdcard/Android/data/$PKG/files/restore/$(basename "$f")" > /dev/null || return 1
  done
  T "am force-stop $PKG"
}

# Выложить собранный APK в релиз GitHub: телевизор сам обновится из шестерёнки.
release() {
  cd "$R" || die "нет $R"
  command -v gh > /dev/null || die "нужен gh (brew install gh, потом gh auth login)"
  APK=launcher/app/build/outputs/apk/release/app-release.apk
  [ -f "$APK" ] || die "сначала tv deploy"
  gh auth status > /dev/null 2>&1 || die "войди в GitHub: gh auth login"
  # Телевизор качает обновления без входа, поэтому хранилище открытое: в нём только APK, ключей там нет.
  gh repo view timuramishov-jpg/tv-home > /dev/null 2>&1 || gh repo create timuramishov-jpg/tv-home --public --add-readme \
    -d "Обновления лаунчера Starwind (только APK)" > /dev/null || die "не создалось хранилище tv-home на GitHub"
  CODE=$(( $(git rev-list --count HEAD) + 100 ))
  cp "$APK" "$DIR/tvhome-$CODE.apk"
  gh release create "v$CODE" "$DIR/tvhome-$CODE.apk" -R timuramishov-jpg/tv-home -t "Лаунчер, сборка $CODE" -n "$(git log -1 --format=%s)" \
    && say "Выложено: v$CODE. На телевизоре: шестерёнка → Обновить лаунчер"
}

deploy() {
  online
  cd "$R" || die "нет $R"
  [ "$(git branch --show-current)" = starwind ] || die "в $R не та ветка, нужна starwind"
  say "== Версия $(git log -1 --format='%h %s')"
  git status --short | grep -v '^??' | grep . && say "(есть несохранённые правки)"
  fonts; icons
  export JAVA_HOME="$(/opt/homebrew/bin/brew --prefix openjdk@17)/libexec/openjdk.jdk/Contents/Home"
  export ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
  export PATH="$JAVA_HOME/bin:$PATH"
  signing
  say "== Тесты пульта"; bash "$R/starwind/test/run.sh" > "$DIR/test.log" 2>&1 || { tail -5 "$DIR/test.log"; die "тесты пульта не прошли, ничего не ставлю"; }
  say "== Сборка"
  (cd launcher && ./gradlew assembleRelease --console=plain > "$DIR/build.log" 2>&1) || { tail -30 "$DIR/build.log"; die "сборка не прошла, лог в build.log"; }
  APK=launcher/app/build/outputs/apk/release/app-release.apk
  "$PY" -I tools/b64push.py "$APK" /data/local/tmp/tvhome.apk || die "загрузка"
  OUT=$(T 'pm install -r /data/local/tmp/tvhome.apk'); say "$OUT"
  case "$OUT" in
    *UPDATE_INCOMPATIBLE*)
      # Лаунчер на телевизоре подписан другим ключом: поверх не встаёт, только удалить и поставить заново.
      if backup; then
        say ">>> Ключ подписи сменился. Лаунчер переустановлю, настройки сохранены в $DIR/backup и вернутся."
      else
        say ">>> Ключ подписи сменился, а копии настроек нет: порядок дока и вход в YouTube придётся настроить заново."
      fi
      printf "Продолжить? [y/N] "; read -r yes
      [ "$yes" = y ] || { T 'rm -f /data/local/tmp/tvhome.apk'; die "отменено"; }
      T "pm uninstall $PKG" | tail -1
      OUT=$(T 'pm install -r /data/local/tmp/tvhome.apk'); say "$OUT"
      case "$OUT" in *Success*) restore && say "Настройки вернул" ;; esac ;;
  esac
  T 'rm -f /data/local/tmp/tvhome.apk'
  case "$OUT" in *Success*) ;; *) die "установка" ;; esac
  T "pm grant $PKG android.permission.READ_TV_LISTINGS; pm grant $PKG android.permission.WRITE_SECURE_SETTINGS" 2>&1 | grep -v '^$'
  # Таймер сна гасит экран правом администратора «только блокировка».
  T "dpm set-active-admin --user 0 $PKG/.IosAdmin" 2>&1 | grep -iv "success\|already" | grep -v '^$'
  # Заставки лаунчера вместо выключенной заставки Яндекса.
  T "settings put secure screensaver_enabled 1; settings put secure screensaver_components $PKG/.IosDream; settings put secure screensaver_default_component $PKG/.IosDream"
  # Обновление с GitHub ставит APK через системный установщик.
  T "appops set $PKG REQUEST_INSTALL_PACKAGES allow"
  # Системные анимации вдвое быстрее (переключается в шестерёнке и в пульте телефона).
  T "settings put global window_animation_scale 0.5; settings put global transition_animation_scale 0.5; settings put global animator_duration_scale 0.5"
  T "am force-stop $PKG; cmd package set-home-activity --user 0 $PKG/.IosHome" > /dev/null
  keys
  home; sleep 12
  report
  T --screenshot "$SHOTS/home.png" 2>&1 | tail -1
  say "РЕЗУЛЬТАТ: готово"
}

check() {
  online
  say "== Домашний экран: $(T 'cmd package resolve-activity --brief -a android.intent.action.MAIN -c android.intent.category.HOME' | tail -1)"
  say "== На экране: $(T 'dumpsys activity activities | grep mResumedActivity | head -1' | sed 's/.*u0 //;s/ t[0-9]*}//')"
  say "== Оболочка Яндекса: $(T 'pm list packages -d | grep -c com.yandex.tv.home' | tr -d '\r' | sed 's/1/выключена/;s/0/ВКЛЮЧЕНА/')"
  say "== VPN: $(T 'dumpsys connectivity | grep -c "VPN CONNECTED"' | tr -d '\r' | sed 's/^0$/выключен/;s/^[1-9].*/включён/')"
  say "== Ключи в лаунчере: $(T "logcat -d -s IosConfig:* | tail -1" | sed 's/.*keys/принято/')"
  say "== Лаунчер занимает: $(T "dumpsys meminfo $PKG | grep -E 'TOTAL PSS|TOTAL:' | head -1" | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/){printf "%d МБ", $i/1024; exit}}')"
  say "== Свободно памяти: $(T 'dumpsys meminfo | grep "Free RAM"' | sed 's/ *Free RAM: *//;s/ (.*//')"
  say "== Падения:"; T 'logcat -b crash -d | grep -E "FATAL|Process:" | tail -4'
}

# Отчёт для Claude: состояние и журнал лаунчера в report.txt рядом со скриптом.
report() {
  { check; say "== Падения лаунчера"; T "tail -40 /sdcard/Android/data/$PKG/files/crash.txt 2>/dev/null || echo нет"
    say "== Журнал"; T "logcat -d -s IosFeed:* IosHome:* IosConfig:* IosRemote:* IosWeather:* IosUpdate:*" | tail -80; } 2>&1 | tee "$DIR/report.txt" | head -12
}

case "${1:-}" in
  pull)
    # Новая версия от Claude: пакет starwind.bundle рядом со скриптом.
    cd "$R" || die "нет $R"
    git fetch -q "$DIR/starwind.bundle" starwind || die "нет пакета starwind.bundle"
    git reset -q --hard FETCH_HEAD && chmod +x starwind/tv && say "== Версия $(git log -1 --format='%h %s')" ;;
  deploy) deploy ;;
  release) release ;;
  report) report ;;
  lighten)
    # Разгрузить телевизор: запретить фон приложениям, которым он не нужен, и отключить лишнее.
    # Всё обратимо: tv lighten off. ВК и Рутуб не трогаем — их фон кормит наши ленты.
    online
    # Happ не трогаем: VPN должен жить в фоне.
    BG="ru.vk.store.tv com.yandex.launcher.updaterapp ru.zonaplayer.app com.yandex.devices.appstore"
    OFF="com.cvte.tv.burn com.yandex.tv.bugreportsender"
    if [ "${2:-}" = off ]; then
      T "for p in $BG; do cmd appops set \$p RUN_ANY_IN_BACKGROUND allow; done; for p in $OFF; do pm enable \$p; done" | grep -v '^$'
      say "Вернул как было"; exit 0
    fi
    say "== Память до"; T 'dumpsys meminfo | grep -E "Free RAM|Used RAM"'
    T "for p in $BG; do cmd appops set \$p RUN_ANY_IN_BACKGROUND ignore 2>&1; am force-stop \$p; done" | grep -v '^$'
    T "for p in $OFF; do pm disable-user --user 0 \$p 2>&1 | tail -1; done"
    sleep 5
    say "== Память после"; T 'dumpsys meminfo | grep -E "Free RAM|Used RAM"'
    say "== Кто занимает больше всего"; T 'dumpsys meminfo | sed -n "/Total PSS by process/,/Total PSS by OOM/p" | head -18' | tee "$DIR/lighten.txt"
    say "Откатить: tv lighten off" ;;
  uninstall) online; T "pm uninstall ${2:?tv uninstall пакет}" | tail -1 ;;
  install) online
    # tv install файл.apk: поставить приложение на телевизор.
    [ -f "${2:-}" ] || die "tv install путь/к/файлу.apk"
    F="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
    (cd "$R" && "$PY" -I tools/b64push.py "$F" /data/local/tmp/app.apk) || die "загрузка"
    T 'pm install -r /data/local/tmp/app.apk; rm -f /data/local/tmp/app.apk' | tail -1 ;;
  aurora) online
    # Aurora Store: магазин приложений Google Play без сервисов Google. Берём с F-Droid.
    mkdir -p "$DIR/apks"
    if ! T 'pm path com.aurora.store' | grep -q package:; then
      [ -s "$DIR/apks/aurora.apk" ] || curl -fL --progress-bar -o "$DIR/apks/aurora.apk" https://f-droid.org/repo/com.aurora.store_76.apk || die "не скачалось"
      (cd "$R" && "$PY" -I tools/b64push.py "$DIR/apks/aurora.apk" /data/local/tmp/app.apk) || die "загрузка"
      T 'pm install -r /data/local/tmp/app.apk; rm -f /data/local/tmp/app.apk' | tail -1
    fi
    # Экраны системных разрешений на этом телевизоре закрыты, поэтому Aurora вылетает на них. Выдаём разрешения сами.
    T 'am force-stop com.aurora.store
       appops set com.aurora.store REQUEST_INSTALL_PACKAGES allow
       appops set com.aurora.store MANAGE_EXTERNAL_STORAGE allow
       pm grant com.aurora.store android.permission.READ_EXTERNAL_STORAGE
       pm grant com.aurora.store android.permission.WRITE_EXTERNAL_STORAGE
       cmd deviceidle whitelist +com.aurora.store' 2>&1 | grep -iv "^$\|added" | head -5
    T 'monkey -p com.aurora.store -c android.intent.category.LAUNCHER 1' > /dev/null 2>&1
    say "Aurora Store стоит и открыта на телевизоре, иконка появится в списке приложений" ;;
  yashell) online
    # Активный аккаунт телевизора выставляет только оболочка Яндекса. Включаем её на минуту, выбираем аккаунт, выключаем.
    T 'pm enable com.yandex.tv.home' | tail -1
    T 'am start -a android.intent.action.MAIN -c android.intent.category.HOME -n com.yandex.tv.home/.HomeActivity' | tail -1
    say ">>> На телевизоре оболочка Яндекса. Зайди в профиль (иконка аккаунта вверху) и выбери аккаунт с подпиской."
    say ">>> Потом нажми Enter здесь."
    read -r _
    T 'pm disable-user --user 0 com.yandex.tv.home' | tail -1
    T "cmd package set-home-activity --user 0 $PKG/.IosHome" > /dev/null; home
    T 'am force-stop ru.kinopoisk.yandex.tv'; sleep 2
    T 'am start -a android.intent.action.MAIN -c android.intent.category.LEANBACK_LAUNCHER -f 0x10200000 -n ru.kinopoisk.yandex.tv/ru.kinopoisk.tv.presentation.splash.SplashActivity' > /dev/null
    sleep 25
    T --screenshot "$SHOTS/kino-acc.png" 2>&1 | tail -1
    home; say "Оболочка снова выключена. Кинопоиск перезапущен с нуля, снимок в shots/kino-acc.png" ;;
  acc) online
    # Текущий аккаунт телевизора в системе Яндекса. tv acc <uid> делает аккаунт текущим.
    U='content://com.yandex.tv.passport/current_account'
    [ -n "${2:-}" ] && T "content call --uri $U --method changeActiveAccount --arg $2" | tail -3
    { say "== текущий"; T "content call --uri $U --method getCurrentAccount"
      say "== активный"; T "content call --uri $U --method getActiveAccount"
      say "== все"; T "content call --uri $U --method getAuthorizedAccounts"
      say "== аккаунты системы"; T 'dumpsys account' | grep -E "Account \{"; } > "$DIR/acc.txt" 2>&1
    head -c 1500 "$DIR/acc.txt" ;;
  account) online
    # Кинопоиск берёт вход у «текущего аккаунта» телевизора. Возвращаем выключенное в kinofix2 и открываем выбор аккаунта.
    T 'for p in com.yandex.tv.alice com.yandex.tv.music com.yandex.android.advid com.yandex.prebuiltstub com.yandex.tv.webplayer com.yandex.tv.bugreportsender com.yandex.tv.daydream; do pm disable-user --user 0 $p; done' | grep -c disabled
    T "content call --uri content://com.yandex.tv.passport/current_account --method getCurrentAccount" | tail -1
    T 'am start -a com.yandex.tv.passport.MANAGE_ACCOUNTS -p com.yandex.tv.services' | tail -1
    say ">>> На телевизоре открылись аккаунты Яндекса. Выбери или добавь свой, потом открой Кинопоиск." ;;
  kinofix2) online
    # Вход Яндекса в приложениях держит одно «главное» приложение Яндекса. Если им выбрано отключённое,
    # вход не сохраняется. Включаем мелкие отключённые пакеты Яндекса (оболочка остаётся выключенной).
    T 'for p in com.yandex.tv.alice com.yandex.tv.music com.yandex.android.advid com.yandex.prebuiltstub com.yandex.tv.webplayer com.yandex.tv.bugreportsender com.yandex.tv.daydream; do pm enable $p; done' | grep -c enabled
    T "cmd package set-home-activity --user 0 $PKG/.IosHome" > /dev/null
    T 'am force-stop ru.kinopoisk.yandex.tv'
    T 'am start -a android.intent.action.MAIN -c android.intent.category.LEANBACK_LAUNCHER -f 0x10200000 -n ru.kinopoisk.yandex.tv/ru.kinopoisk.tv.presentation.splash.SplashActivity' > /dev/null
    say ">>> Войди в Кинопоиск на телевизоре заново. Когда вошёл и видишь главную, нажми Enter здесь."
    read -r _
    T 'am force-stop ru.kinopoisk.yandex.tv'; sleep 2
    T 'am start -a android.intent.action.MAIN -c android.intent.category.LEANBACK_LAUNCHER -f 0x10200000 -n ru.kinopoisk.yandex.tv/ru.kinopoisk.tv.presentation.splash.SplashActivity' > /dev/null
    sleep 25
    T --screenshot "$SHOTS/kino-fix2.png" 2>&1 | tail -1
    T 'dumpsys account' | grep -E "Account \{" > "$DIR/kinotest.txt"
    say "Кинопоиск перезапущен с нуля, снимок в shots/kino-fix2.png" ;;
  kinofix) online
    # Проверка: нужна ли Кинопоиску оболочка Яндекса, чтобы видеть вход. Наш лаунчер остаётся домашним.
    T 'pm enable com.yandex.tv.home' | tail -1
    T "cmd package set-home-activity --user 0 $PKG/.IosHome" > /dev/null
    T 'am force-stop ru.kinopoisk.yandex.tv'; sleep 2
    T 'am start -a android.intent.action.MAIN -c android.intent.category.LEANBACK_LAUNCHER -f 0x10200000 -n ru.kinopoisk.yandex.tv/ru.kinopoisk.tv.presentation.splash.SplashActivity' > /dev/null
    sleep 25
    T --screenshot "$SHOTS/kino-fix.png" 2>&1 | tail -1
    say "Снимок в shots/kino-fix.png. Оболочка Яндекса пока включена, вернуть как было: tv slim" ;;
  kinotest) online
    # Холодный запуск Кинопоиска тем же способом, что и с иконки: просит ли он вход.
    { say "== Аккаунты"; T 'dumpsys account' | grep -E "Account \{|type=|ServiceInfo: AuthenticatorDescription" | head -30
      say "== Отключённые пакеты"; T 'pm list packages -d'; } > "$DIR/kinotest.txt" 2>&1
    T 'am force-stop ru.kinopoisk.yandex.tv; logcat -c'
    T 'am start -a android.intent.action.MAIN -c android.intent.category.LEANBACK_LAUNCHER -f 0x10200000 -n ru.kinopoisk.yandex.tv/ru.kinopoisk.tv.presentation.splash.SplashActivity' | tail -2 >> "$DIR/kinotest.txt"
    sleep 25
    T --screenshot "$SHOTS/kino-cold.png" 2>&1 | tail -1
    T 'logcat -d' | grep -iE "ActivityTaskManager: (START|Displayed)|ActivityManager: (Start proc|Process ru.kinopoisk)|passport|account|kinopoisk.*(E |W )" | grep -v GooglePlayServicesUtil | tail -80 >> "$DIR/kinotest.txt"
    home; say "Готово: kinotest.txt и shots/kino-cold.png" ;;
  trace) online
    T 'logcat -c'
    say ">>> Открой на телевизоре афишу (или что не работает). Записываю журнал 40 секунд."
    sleep 40
    T 'logcat -d' | grep -iE "IosFeed|IosHome|kinopoisk|passport|AccountManager|ActivityTaskManager: (START|Displayed)|AndroidRuntime" | tail -300 > "$DIR/trace.txt"
    say "Готово, журнал в trace.txt" ;;
  kino) online
    T "am start -a android.intent.action.VIEW -d 'kpatv://film?filmId=${2:-301}' -p ru.kinopoisk.yandex.tv" | tail -1; sleep 10
    T --screenshot "$SHOTS/kino.png" 2>&1 | tail -1; home; say "Снимок в shots/kino.png" ;;
  check) check ;;
  keys) online; keys ;;
  shot) online; T --screenshot "$SHOTS/${2:-now}.png" 2>&1 | tail -1 ;;
  log) online; T "logcat -d -s IosFeed:* IosHome:* IosConfig:*" | tail -${2:-60} ;;
  reboot) online; T 'sync'; T --reboot; say "Перезагружаю. Через минуту: tv check" ;;
  route)
    online
    case "${2:-}" in
      off) T 'am start -a android.intent.action.VIEW -d happ://routing/off -n su.happ.proxyutility/.feature.main.MainActivity' > /dev/null; say "Маршрутизация Happ выключена: через VPN идёт всё" ;;
      on) bash "$R/starwind/route-on.sh" ;;
      *) say "tv route on|off" ;;
    esac ;;
  adb)
    online
    [ "${2:-}" = off ] || { say "tv adb off: выключить отладку. Включить обратно: Настройки лаунчера, Отладка по сети"; exit 0; }
    T 'settings put global adb_enabled 0' ; say "Отладка выключена. Включить: Настройки лаунчера, Отладка по сети" ;;
  agent)
    # Копия скрипта: агент не сломается, когда tv pull обновит файлы под ним.
    A=$(mktemp -t starwind-agent); cp "$R/starwind/agent.sh" "$A"; exec bash "$A" ;;
  backup) online; backup && say "Настройки лаунчера в $DIR/backup" || die "копии на телевизоре пока нет: лаунчер делает её, когда уходишь с главного экрана" ;;
  slim) online; T 'for p in com.yandex.tv.input.efir com.yandex.tv.videoplayer com.yandex.devices.farm.companion com.yandex.tv.home; do pm disable-user --user 0 $p; done' | grep -c disabled-user ;;
  rollback)
    online
    T 'for p in com.yandex.tv.home com.yandex.tv.input.efir com.yandex.tv.videoplayer com.yandex.devices.farm.companion; do pm enable $p; done; cmd package set-home-activity --user 0 com.yandex.tv.home/.HomeActivity' | tail -1
    say "Вернул оболочку Яндекса домашним экраном. Наш лаунчер остаётся установленным." ;;
  *) cat <<'H'
tv deploy        собрать текущую версию, поставить, передать ключи, проверить
tv check         что сейчас на телевизоре: домашний экран, VPN, память, падения
tv pull          забрать новую версию от Claude (starwind.bundle)
tv release       выложить собранный лаунчер на GitHub: телек обновится сам
tv lighten       разгрузить телек: запрет фона лишним приложениям (off — вернуть)
tv report        то же и журнал лаунчера, в report.txt для Claude
tv trace         записать журнал, пока ты что-то делаешь на телеке, в trace.txt
tv keys          заново передать ключи сервисов из secrets.json
tv shot [имя]    снимок экрана в shots/
tv log [N]       последние строки журнала лаунчера
tv route on|off  VPN только для YouTube или для всего
tv adb off       выключить отладку по сети
tv aurora        поставить Aurora Store (Google Play без сервисов Google)
tv install F.apk поставить любое приложение
tv slim          отключить лишнее Яндекса и его оболочку
tv backup        забрать копию настроек лаунчера в backup/
tv agent         Claude сам отдаёт команды телевизору (окно оставить открытым)
tv rollback      вернуть оболочку Яндекса
tv reboot        перезагрузить телевизор
H
  ;;
esac
